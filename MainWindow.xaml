<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="utc_clock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:utc_clock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UTC"
    mc:Ignorable="d">
    <Grid Background="#FF18181B">
        <Border
            x:Name="RootBorder"
            Background="#FF18181B"
            CornerRadius="0">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="TimeText"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="#FFFAFAFA"
                    Text="--:--"
                    TextLineBounds="Tight" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    CharacterSpacing="60"
                    FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="#FFE8E8EC"
                    Text="UTC"
                    TextLineBounds="Tight" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
